# Keep the data directory in Git without uploading local data or outputs.
data/*
!data/.gitkeep
!data/LICENSE-Planet.txt
*.asv
*.m~
__pycache__/

# Local credentials and editor or agent configuration
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
**/.agents/
**/.vscode/
*.pem
*.key
*.p12
*.pfx
